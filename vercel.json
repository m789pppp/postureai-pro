{
  "version": 2,
  "buildCommand": "npm install && cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' https://cdn.jsdelivr.net https://*.firebaseapp.com https://*.googleapis.com https://js.stripe.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://postureai-pro-omega-nine.vercel.app https://*.googleapis.com https://*.firebaseio.com https://*.firebaseapp.com wss://*.firebaseio.com https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firebase.googleapis.com https://api.stripe.com https://checkout.kashier.io https://corvus-omega-nine.vercel.app https://corvus-omega.vercel.app https://get.geojs.io https://*.up.railway.app https://cdn.jsdelivr.net https://apis.google.com https://fonts.gstatic.com https://huggingface.co https://*.huggingface.co https://raw.githubusercontent.com https://cdn-lfs.huggingface.co https://cdn-lfs-us-1.huggingface.co https://text.pollinations.ai https://gen.pollinations.ai https://api.llm7.io https://oai.endpoints.kepler.ai.cloud.ovh.net https://aihorde.net https://api.together.xyz https://api.together.ai https://openrouter.ai https://api.openrouter.ai https://*.puter.com https://puter.com; frame-src 'self' https://checkout.kashier.io https://js.stripe.com https://*.firebaseapp.com https://accounts.google.com; worker-src blob: 'self'; object-src 'none';"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/api/account/delete",
      "dest": "/api/account/delete.js"
    },
    {
      "src": "/api/llm",
      "dest": "/api/llm.js"
    },
    {
      "src": "/api/ai-chat",
      "dest": "/api/llm.js"
    },
    {
      "src": "/api/kashier/create-order",
      "dest": "/api/kashier/create-order.js"
    },
    {
      "src": "/api/kashier/webhook",
      "dest": "/api/kashier/webhook.js"
    },
    {
      "src": "/api/notify/dispatch",
      "dest": "/api/notify/dispatch.js"
    },
    {
      "src": "/api/auth/mfa/totp/setup",
      "dest": "/api/auth/mfa.js"
    },
    {
      "src": "/api/auth/mfa/totp/verify",
      "dest": "/api/auth/mfa.js"
    },
    {
      "src": "/api/auth/mfa/sms/send",
      "dest": "/api/auth/mfa.js"
    },
    {
      "src": "/api/auth/mfa/sms/verify",
      "dest": "/api/auth/mfa.js"
    },
    {
      "src": "/api/auth/mfa/disable",
      "dest": "/api/auth/mfa.js"
    },
    {
      "src": "/api/auth/mfa/backup-codes/regenerate",
      "dest": "/api/auth/mfa.js"
    },
    {
      "src": "/api/auth/mfa/login-verify",
      "dest": "/api/auth/mfa.js"
    },
    {
      "src": "/api/org/invite/accept",
      "dest": "/api/org/invite.js"
    },
    {
      "src": "/api/org/invite/consent",
      "dest": "/api/org/invite.js"
    },
    {
      "src": "/api/employee/consent",
      "dest": "/api/org/invite.js"
    },
    {
      "src": "/api/org/create-invite",
      "dest": "/api/org/invite.js"
    },
    {
      "src": "/api/email/welcome",
      "dest": "/api/email/send.js"
    },
    {
      "src": "/api/email/invoice",
      "dest": "/api/email/send.js"
    },
    {
      "src": "/api/email/weekly-report",
      "dest": "/api/email/send.js"
    },
    {
      "src": "/api/email/weekly-progress",
      "dest": "/api/email/send.js"
    },
    {
      "src": "/api/email/sequence",
      "dest": "/api/email/send.js"
    },
    {
      "src": "/api/admin/seed-flags",
      "dest": "/api/admin/seed-flags.js"
    },
    {
      "src": "/api/cron/symptom-pattern-alerts",
      "dest": "/api/cron/symptom-pattern-alerts.js"
    },
    {
      "src": "/api/habits/whatsapp-test",
      "dest": "/api/habits/whatsapp-test.js"
    },
    {
      "src": "/api/habits/whatsapp-cron",
      "dest": "/api/habits/whatsapp-cron.js"
    },
    {
      "src": "/api/cert/issue",
      "dest": "/api/cert/issue.js"
    },
    {
      "src": "/api/cert/verify",
      "dest": "/api/cert/verify.js"
    },
    {
      "src": "/api/posture-api/analyze",
      "dest": "/api/posture-api/analyze.js"
    },
    {
      "src": "/api/posture-api/keys",
      "dest": "/api/posture-api/keys.js"
    },
    {
      "src": "/api/posture-api/usage",
      "dest": "/api/posture-api/usage.js"
    },
    {
      "src": "/api/support/whatsapp-inbound",
      "dest": "/api/support/whatsapp-inbound.js"
    },
    {
      "src": "/api/support/reply",
      "dest": "/api/support/reply.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://postureai-backend.up.railway.app/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/account/delete.js": {
      "maxDuration": 30
    },
    "api/kashier/create-order.js": {
      "maxDuration": 15
    },
    "api/kashier/webhook.js": {
      "maxDuration": 30
    },
    "api/notify/dispatch.js": {
      "maxDuration": 15
    },
    "api/auth/mfa.js": {
      "maxDuration": 15
    },
    "api/org/invite.js": {
      "maxDuration": 15
    },
    "api/email/send.js": {
      "maxDuration": 15
    },
    "api/admin/seed-flags.js": {
      "maxDuration": 30
    },
    "api/support/whatsapp-inbound.js": {
      "maxDuration": 15
    },
    "api/support/reply.js": {
      "maxDuration": 15
    },
    "api/cron/symptom-pattern-alerts.js": {
      "maxDuration": 60
    },
    "api/habits/whatsapp-test.js": {
      "maxDuration": 15
    },
    "api/habits/whatsapp-cron.js": {
      "maxDuration": 60
    },
    "api/cert/issue.js": {
      "maxDuration": 15
    },
    "api/cert/verify.js": {
      "maxDuration": 10
    },
    "api/posture-api/analyze.js": {
      "maxDuration": 10
    },
    "api/posture-api/keys.js": {
      "maxDuration": 15
    },
    "api/posture-api/usage.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron/symptom-pattern-alerts",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/habits/whatsapp-cron",
      "schedule": "0 * * * *"
    }
  ]
}