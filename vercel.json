{
  "version": 2,
  "buildCommand": "npm install && cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' https://cdn.jsdelivr.net https://*.firebaseapp.com https://*.googleapis.com https://js.stripe.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://postureai-pro-omega-nine.vercel.app https://*.googleapis.com https://*.firebaseio.com https://*.firebaseapp.com wss://*.firebaseio.com https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firebase.googleapis.com https://api.stripe.com https://checkout.kashier.io https://corvus-omega-nine.vercel.app https://corvus-omega.vercel.app https://get.geojs.io https://*.up.railway.app https://cdn.jsdelivr.net https://apis.google.com https://fonts.gstatic.com https://huggingface.co https://*.huggingface.co https://raw.githubusercontent.com https://cdn-lfs.huggingface.co https://cdn-lfs-us-1.huggingface.co https://text.pollinations.ai https://gen.pollinations.ai https://api.llm7.io https://oai.endpoints.kepler.ai.cloud.ovh.net https://aihorde.net https://api.together.xyz https://api.together.ai https://openrouter.ai https://api.openrouter.ai https://*.puter.com https://puter.com; frame-src 'self' https://checkout.kashier.io https://js.stripe.com https://*.firebaseapp.com https://accounts.google.com; worker-src blob: 'self'; object-src 'none';"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/llm",
      "dest": "/api/llm.js"
    },
    {
      "src": "/api/ai-chat",
      "dest": "/api/llm.js"
    },
    {
      "src": "/api/kashier/create-order",
      "dest": "/api/kashier.js"
    },
    {
      "src": "/api/kashier/webhook",
      "dest": "/api/kashier.js"
    },
    {
      "src": "/api/auth/(.*)",
      "dest": "/api/auth.js"
    },
    {
      "src": "/api/habits/whatsapp-cron",
      "dest": "/api/habits.js"
    },
    {
      "src": "/api/habits/whatsapp-test",
      "dest": "/api/habits.js"
    },
    {
      "src": "/api/session/start",
      "dest": "/api/session.js"
    },
    {
      "src": "/api/session/health",
      "dest": "/api/session.js"
    },
    {
      "src": "/api/session/snapshot",
      "dest": "/api/session.js"
    },
    {
      "src": "/api/posture-api/analyze",
      "dest": "/api/posture.js"
    },
    {
      "src": "/api/posture-api/keys",
      "dest": "/api/posture.js"
    },
    {
      "src": "/api/posture-api/usage",
      "dest": "/api/posture.js"
    },
    {
      "src": "/api/referral/stats",
      "dest": "/api/referral.js"
    },
    {
      "src": "/api/referral/track",
      "dest": "/api/referral.js"
    },
    {
      "src": "/api/support/reply",
      "dest": "/api/support.js"
    },
    {
      "src": "/api/support/whatsapp-inbound",
      "dest": "/api/support.js"
    },
    {
      "src": "/api/cert/issue",
      "dest": "/api/cert.js"
    },
    {
      "src": "/api/cert/verify",
      "dest": "/api/cert.js"
    },
    {
      "src": "/api/account/(.*)",
      "dest": "/api/misc.js"
    },
    {
      "src": "/api/admin/(.*)",
      "dest": "/api/misc.js"
    },
    {
      "src": "/api/email/(.*)",
      "dest": "/api/misc.js"
    },
    {
      "src": "/api/metrics/(.*)",
      "dest": "/api/misc.js"
    },
    {
      "src": "/api/notify/(.*)",
      "dest": "/api/misc.js"
    },
    {
      "src": "/api/org/(.*)",
      "dest": "/api/misc.js"
    },
    {
      "src": "/api/cron/(.*)",
      "dest": "/api/misc.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/llm.js": {
      "runtime": "edge"
    },
    "api/kashier.js": {
      "maxDuration": 30
    },
    "api/auth.js": {
      "maxDuration": 30
    },
    "api/habits.js": {
      "maxDuration": 60
    },
    "api/session.js": {
      "maxDuration": 30
    },
    "api/posture.js": {
      "maxDuration": 30
    },
    "api/referral.js": {
      "maxDuration": 15
    },
    "api/support.js": {
      "maxDuration": 30
    },
    "api/cert.js": {
      "maxDuration": 15
    },
    "api/misc.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/symptom-pattern-alerts",
      "schedule": "0 9 * * 1"
    }
  ]
}