{
  "name": "corvus",
  "private": true,
  "version": "17.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "lint": "eslint src --ext .js,.jsx --report-unused-disable-directives --max-warnings 9999",
    "typecheck": "tsc --noEmit 2>/dev/null || true",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "analyze": "vite-bundle-visualizer",
    "fetch:mediapipe": "node scripts/fetch-mediapipe.mjs",
    "prebuild": "node scripts/fetch-mediapipe.mjs",
    "test:engine": "node src/features/analysis/postureEngine.selftest.mjs",
    "test:accuracy": "node src/features/analysis/postureEngine.accuracy.mjs",
    "test:blur": "node src/lib/faceBlur.test.mjs",
    "test:pdf": "node src/lib/pdfReports.test.mjs",
    "test:clinical": "node src/lib/clinicalMetrics.test.mjs",
    "test:posture": "npm run test:engine && npm run test:accuracy"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "@mlc-ai/web-llm": "^0.2.84",
    "@sentry/react": "^8.0.0",
    "firebase": "^10.12.0",
    "framer-motion": "^12.40.0",
    "jspdf": "^4.2.1",
    "posthog-js": "^1.131.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "terser": "^5.49.0",
    "vite": "^5.4.1",
    "vite-bundle-visualizer": "^1.0.0"
  }
}
