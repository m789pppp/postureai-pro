{
  "name": "corvus-postureai-pro",
  "version": "1.0.0",
  "private": true,
  "description": "Corvus PostureAI Pro — root package for Vercel serverless functions",
  "scripts": {
    "check:routes": "node scripts/check-api-routes.mjs",
    "deploy:rules": "npx --yes firebase-tools@13 deploy --only firestore:rules,firestore:indexes",
    "test:rules": "npm --prefix tests/rules install --silent && npm --prefix tests/rules test",
    "preflight": "node scripts/preflight.mjs",
    "probe:routes": "node scripts/probe-routes.mjs",
    "test:guard": "node api/_lib/routerGuard.test.mjs"
  },
  "dependencies": {
    "firebase-admin": "^12.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
